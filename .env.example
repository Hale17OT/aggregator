# Local fixture-only stack. Do not point at production.
HOST=127.0.0.1
PORT=4000
NUXT_API_BASE=http://127.0.0.1:4000
APP_ORIGIN=http://127.0.0.1:3000
PERSISTENCE_ADAPTER=memory
# HTTP session cookies are nonproduction loopback-only. Production requires HTTPS APP_ORIGIN.
# Do not set FIXTURE_SESSION_ISSUANCE: the normal server has no fixture issuer.
REAL_INGESTION_ENABLED=false
LIVE_GENERATION_ENABLED=false
PUBLIC_PUBLICATION_ENABLED=false
# DATABASE_URL is forbidden. PostgreSQL fixture verification uses test:identity:db.
# That harness sets PERSISTENCE_ADAPTER=postgresql and DISPOSABLE_DB_TARGET to its verified manifest.
# Do not point the local-only profile at an existing or production database.
