{
  "name": "the-aggregator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:web": "nuxt dev apps/web --host 127.0.0.1 --port 3000",
    "worker:check": "tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit && nuxt typecheck apps/web",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json && nuxt build apps/web",
    "lint": "eslint apps packages tests scripts/*.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "test:newspaper": "node scripts/check-newspaper.mjs",
    "test:controls": "node scripts/check-controls.mjs",
    "test:db": "node scripts/test-database.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --self-test",
    "check:ci": "node scripts/check-ci.mjs",
    "check:repro": "node scripts/check-reproducible.mjs",
    "tools:install": "node scripts/foundation-tools.mjs install",
    "test:identity": "npm run build && node scripts/check-identity.mjs",
    "test:identity:db": "npm run build && node --import tsx scripts/check-identity-db.mjs",
    "demo:start": "node --import tsx scripts/demo.mjs start",
    "demo:stop": "node --import tsx scripts/demo.mjs stop",
    "tools:mailpit": "node scripts/install-mailpit.mjs",
    "test:local-auth": "node --import tsx scripts/check-local-auth.mjs",
    "programmes:generate": "node --import tsx scripts/generate-programmes.mjs",
    "test:programmes": "node --import tsx scripts/check-programmes.mjs",
    "test:programmes:ui": "node scripts/check-broadcast-video-ui.mjs",
    "test:member:demo": "node scripts/check-member-demo.mjs",
    "demo:restart-api": "node --import tsx scripts/demo.mjs restart-api",
    "test:listening:db": "node --import tsx scripts/check-listening-db.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "test:discovery:ui": "node scripts/check-discovery.mjs",
    "test:radio:ui": "node scripts/check-radio-ui.mjs",
    "test:demo": "node scripts/check-demo.mjs",
    "demo:restart-web": "node --import tsx scripts/demo.mjs restart-web",
    "broadcast:render": "node scripts/render-broadcast.mjs --ffmpeg .cache/tools/ffmpeg/ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe",
    "broadcast:import": "node --import tsx scripts/import-broadcast.mjs",
    "test:broadcast:assets": "node --import tsx scripts/check-broadcast-assets.mjs",
    "test:broadcast:ui": "node scripts/check-broadcast-video-ui.mjs",
    "postinstall": "node scripts/patch-auto-animate.mjs",
    "test:editorial-engine": "node scripts/test-editorial-engine.mjs",
    "editorial:demo": "node scripts/editorial-demo.mjs",
    "test:reader-completion": "node scripts/test-reader-completion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/unifrakturmaguntia": "5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "express": "5.3.0",
    "nuxt": "4.6.1",
    "pg": "8.23.1",
    "reka-ui": "2.11.0",
    "vue": "3.5.43",
    "zod": "4.6.6",
    "ultrahtml": "1.7.0",
    "sax": "1.6.1"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1"
  }
}
